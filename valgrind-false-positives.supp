# This is a Valgrind suppression file to suppress false positives.
# Run Valgrind with --gen-suppressions=all to print a suppression after each warning,
# and if it is a false positive append it to this file.

# PHP internals: uninitialised value warnings during module startup.
# These come from the PHP binary itself (no debug symbols), not from our extension.
# A PHP built with --with-valgrind would not trigger these.
{
   php_module_startup_cond
   Memcheck:Cond
   ...
   fun:php_module_startup
   ...
}
{
   php_module_startup_value8
   Memcheck:Value8
   ...
   fun:php_module_startup
   ...
}

# Zend JIT (IR compiler): uninitialised value warnings in ir_sparse_set_in.
# These come from the JIT's IR backend, not from our extension.
{
   zend_jit_ir_sparse_set_cond
   Memcheck:Cond
   fun:ir_sparse_set_in
   ...
   fun:zend_jit_ir_compile
   ...
}
{
   zend_jit_ir_sparse_set_value8
   Memcheck:Value8
   fun:ir_sparse_set_in
   ...
   fun:zend_jit_ir_compile
   ...
}
