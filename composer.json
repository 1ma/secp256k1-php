{
    "name": "uma/secp256k1",
    "type": "php-ext",
    "license": "MIT",
    "description": "Native bindings for libsecp256k1",
    "require": {
        "php": ">=8.2"
    },
    "php-ext": {
        "extension-name": "secp256k1",
        "configure-options": [
            {
                "name": "with-secp256k1",
                "needs-value": false,
                "description": "for secp256k1 support"
            }
        ]
    },
    "scripts": {
        "build": "phpize && ./configure && make",
        "test": "make test TESTS=\"-q -m --show-diff --show-mem\" VALGRIND_OPTS=\"--gen-suppressions=all --suppressions=valgrind-false-positives.supp\""
    }
}
