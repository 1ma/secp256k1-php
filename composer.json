{
    "name": "uma/secp256k1",
    "type": "php-ext",
    "license": "MIT",
    "description": "Native bindings for libsecp256k1",
    "require": {
        "php": ">=8.2"
    },
    "php-ext": {
        "extension-name": "secp256k1",
        "configure-options": [
            {
                "name": "with-secp256k1",
                "needs-value": false,
                "description": "for secp256k1 support"
            }
        ]
    },
    "scripts": {
        "ext:clean": "make distclean",
        "ext:secp256k1": [
            "cmake -S secp256k1 -B $(pwd)/build/secp256k1 -DCMAKE_INSTALL_PREFIX=$(pwd)/build/secp256k1 -DSECP256K1_ENABLE_MODULE_RECOVERY=ON -DSECP256K1_BUILD_BENCHMARK=OFF -DSECP256K1_BUILD_CTIME_TESTS=OFF -DSECP256K1_BUILD_TESTS=OFF -DSECP256K1_BUILD_EXHAUSTIVE_TESTS=OFF",
            "cmake --build $(pwd)/build/secp256k1 -j$(nproc)",
            "cmake --install $(pwd)/build/secp256k1"
        ],
        "ext:build": ["phpize", "PKG_CONFIG_PATH=$(pwd)/build/secp256k1/lib/pkgconfig ./configure", "make"],
        "ext:build-cov": ["phpize", "PKG_CONFIG_PATH=$(pwd)/build/secp256k1/lib/pkgconfig CFLAGS=\"--coverage -O0 -g\" LDFLAGS=\"--coverage\" ./configure", "make"],
        "ext:test": "make test TESTS=\"-q --show-diff\"",
        "ext:test-valgrind": "make test TESTS=\"-q -m --show-diff --show-mem\" VALGRIND_OPTS=\"--gen-suppressions=all --suppressions=valgrind-false-positives.supp\"",
        "ext:cov-report": [
            "lcov --capture --directory .libs --output-file coverage.info",
            "lcov --remove coverage.info '/usr/include/*' -o coverage.info",
            "genhtml coverage.info --output-directory coverage-html"
        ]
    },
    "scripts-descriptions": {
        "ext:secp256k1": "Build libsecp256k1 from the git submodule with all modules enabled",
        "ext:clean": "Clean up build artifacts",
        "ext:build": "Build extension with default configuration",
        "ext:build-cov": "Build extension with coverage instrumentation",
        "ext:test": "Run extension test suite",
        "ext:test-valgrind": "Run extension test suite with Valgrind memcheck",
        "ext:cov-report": "Generate lcov and html coverage reports after ext:build-cov and ext:test"
    }
}
